# Copy this file to .env (in this backend/ directory) and fill in real values.
# Never commit the real .env file.

# --- Reddit API (data/collect_reddit.py) -----------------------------------
# Create an app at https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=somnium-dream-collector/0.1 by <your-reddit-username>

# --- Optional local corpus (data/dreambank_loader.py) ----------------------
# Path to a local DreamBank export file (not committed to git).
DREAMBANK_FILE_PATH=

# --- Feature flags -----------------------------------------------------------
ENABLE_SLEEP_MODULE=false
ENABLE_DISTILBERT=false
ENABLE_FEATURE_PROFILE=false
